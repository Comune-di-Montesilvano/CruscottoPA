# CruscottoPA — configurazione di esempio
# Copia in .env e adatta. Non committare mai .env.
# Su Portainer: imposta le stesse variabili nella sezione "Environment variables" dello stack.

# ── Server ──────────────────────────────────────────────────────────────────
# Porta HTTP, identica dentro e fuori dal container. Deve essere > 1024
# (container non root / Podman rootless).
PORT=8080

# Fuso orario del container
TZ=Europe/Rome

# Solo build locale (docker compose up --build): versione mostrata in UI,
# con suffisso "-DEV". Le immagini ufficiali ricevono il tag git dalla CI.
#VERSION=dev

# Livello di log: debug, info, warn, error
LOG_LEVEL=info

# ── Backup ─────────────────────────────────────────────────────────────────
# Ogni quante ore creare un backup automatico (DB + uploads) in /data/backups.
# 0 = disattivati. Le copie stanno nello stesso volume: scaricane una
# periodicamente da /admin/backup e conservala fuori dal server.
BACKUP_INTERVAL_HOURS=24

# ── Guide da GitHub ────────────────────────────────────────────────────────
# Ogni quante ore riscaricare le guide da GitHub (0 = solo "Aggiorna ora").
GUIDE_REFRESH_HOURS=6
# Proxy di uscita verso Internet, se il server non esce direttamente
# (usato anche dalle notifiche push). Vuoto = connessione diretta.
HTTPS_PROXY=

# ── Sessione admin ─────────────────────────────────────────────────────────
# Obbligatorio (min 32 caratteri) con LDAP reale. Genera con: openssl rand -hex 32
SESSION_SECRET=
# true = cookie solo su HTTPS. Dietro reverse proxy HTTPS viene dedotto da X-Forwarded-Proto.
# Accesso diretto via http://host:porta (senza HTTPS): impostare false, altrimenti il login non regge.
SECURE_COOKIES=true

# ── LDAP / Active Directory (login /admin) ─────────────────────────────────
# Obbligatorio: senza LDAP_HOST il container non parte.
LDAP_HOST=ldaps://dc.example.local:636
# Solo sviluppo: mock accetta QUALSIASI credenziale come admin. Mai in produzione.
#LDAP_HOST=mock
LDAP_BASE_DN=dc=example,dc=local
# %s = username digitato. UPN: %s@example.local — DN classico: uid=%s,ou=Users,dc=example,dc=local
LDAP_USER_DN_TEMPLATE=%s@example.local
# Su ldap:// esegue StartTLS; se fallisce il login fallisce (nessun ripiego in chiaro)
LDAP_STARTTLS=true
LDAP_TLS_SKIP_VERIFY=false
# Account di servizio per la ricerca gruppi (vuoto = sessione dell'utente)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# CN del gruppo richiesto per il login (vuoto = tutti)
LDAP_REQUIRED_GROUP=
# CN del gruppo amministratori
LDAP_ADMIN_GROUP=
# Admin espliciti separati da ';'. In mock: vuoto = tutti admin.
ADMIN_USERS=

# ── Riconoscimento utente in plancia (NTLM) ────────────────────────────────
# Dominio NetBIOS dei PC (es. COMUNE-MS). Vuoto = riconoscimento spento.
# Richiede LDAP_BIND_DN: il nome dell'utente si legge da AD (displayName).
# L'utente è DICHIARATO dal browser, non verificato: serve solo a personalizzare.
NTLM_DOMAIN=
# IP del PC (testata «Questo PC» e ticket): nome NTLM + suffisso, risolto nel DNS
# del dominio. Vuoto = niente IP. Es. intranet.example.local
PC_DNS_SUFFIX=
# DNS da interrogare (vuoto = quello del container). Serve se il container non
# usa il DNS del dominio (es. Docker Desktop). Es. 10.0.0.254
PC_DNS_SERVER=

# ── Notifiche push (browser chiuso) ────────────────────────────────────────
# Contatto richiesto dai servizi push (mailto: o https:). Vuoto = Web Push spento;
# le notifiche a plancia aperta funzionano comunque. Il server deve uscire su Internet.
VAPID_SUBJECT=

# ── Ticket di assistenza (OTRS) ────────────────────────────────────────────
# URL del web service REST (GenericInterface), senza / finale:
# https://<host>/otrs/nph-genericinterface.pl/Webservice/<nome>
# Vuoto = modulo spento (nessuna tile). "mock" solo con LDAP_HOST=mock.
# Meglio l'indirizzo interno di OTRS, non quello dietro il reverse proxy (limite 1 MB):
# deve comunque essere https (con certificato valido per il container).
OTRS_URL=
# Route configurate nel web service (POST per create, PATCH per update)
OTRS_ROUTE_CREATE=/TicketCreate
OTRS_ROUTE_UPDATE=/TicketUpdate
# Lettura dei propri ticket in plancia: POST per la ricerca, GET per TicketGet
# (route con :TicketID nel percorso, oppure senza, es. /TicketGet: l'ID va nel corpo)
OTRS_ROUTE_SEARCH=/TicketSearch
OTRS_ROUTE_GET=/Ticket/:TicketID
# Agente dedicato con permessi create, ro e rw sulla coda
OTRS_USER=
OTRS_PASSWORD=
# Nome esatto della coda (maiuscole e minuscole contano)
OTRS_QUEUE=
# Casella dell'assistenza mostrata se OTRS non risponde
OTRS_FALLBACK_EMAIL=

# ── Sviluppo locale ───────────────────────────────────────
# Decommentare per caricare docker-compose.dev.yml con "docker compose up":
# sorgente montato e go run, dopo una modifica basta "docker compose restart".
# Mai su Portainer.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
